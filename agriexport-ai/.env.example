DATABASE_URL=postgresql+psycopg://agriexport:localdev@localhost:5432/agriexport
RAW_STORAGE_PATH=./data/raw
COMTRADE_API_KEY=
# Optional: a licensed/approved endpoint; never put secrets in a URL.
COMTRADE_BASE_URL=https://comtradeapi.un.org/public/v1/preview/C/M/HS
# Pilot private API: JSON mapping SHA256(token) -> tenant_id, actor_id and roles.
# No credentials by default. Never put raw bearer tokens in this file or in source.
AGRI_AUTH_CREDENTIALS={}
# Optional pluggable JSON extraction service. Receives official public text only.
EVENT_EXTRACTOR_ENDPOINT=
EVENT_EXTRACTOR_API_KEY=
# Next.js server-side proxy settings. No shared Bearer token is embedded in the UI.
AGRI_API_ORIGIN=http://127.0.0.1:8000
AGRI_DASHBOARD_ORIGIN=http://127.0.0.1:3000
# Optional automation extra; no unattended scheduler starts on installation/import.
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
PREFECT_HOME=./data/prefect
PREFECT_SERVER_ANALYTICS_ENABLED=false
